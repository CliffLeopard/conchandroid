<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 读取应用列表权限，这个权限无法在Google应用商店上架 -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
        </intent>
    </queries>

    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:name=".ConchApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Conchandroid"
        tools:targetApi="31">
        <activity
            android:name=".scene.ShellActivity"
            android:exported="false" />
        <activity
            android:name=".scene.FilePathActivity"
            android:exported="false" />
        <activity
            android:name=".scene.install.InstallPackageActivity"
            android:exported="false" />

        <service
            android:name=".scene.SimpleService"
            android:enabled="true"
            android:exported="false"
            android:process=":.simple_service" />

        <activity
            android:name=".box.EgoActivity"
            android:exported="false" />
        <activity
            android:name=".scene.bp.BinderProviderActivity"
            android:exported="false" />
        <activity
            android:name=".scene.HiddenApiActivity"
            android:exported="false" />
        <activity
            android:name=".scene.WebViewScreenShotActivity"
            android:exported="false" />
        <activity
            android:name=".scene.TextureViewActivity"
            android:exported="false" />
        <activity
            android:name=".scene.SimpleCasesActivity"
            android:exported="false" />
        <activity
            android:name=".scene.ANRSummaryActivity"
            android:exported="false" />
        <activity
            android:name=".scene.LeakBActivity"
            android:exported="false" />
        <activity
            android:name=".scene.LeakActivity"
            android:exported="false" />
        <activity
            android:name=".scene.EventActivity"
            android:exported="false" />
        <activity
            android:name=".scene.CoroutineActivity"
            android:exported="false" />
        <activity
            android:name=".scene.RxJavaActivity"
            android:exported="false" />
        <activity
            android:name=".scene.provider.ProviderActivity"
            android:exported="false" />
        <activity
            android:name=".scene.ANRActivity"
            android:exported="false" />
        <activity
            android:name=".scene.NativeMessageActivity"
            android:exported="false" />
        <activity
            android:name=".scene.PineActivity"
            android:exported="false" />
        <activity
            android:name=".scene.SelfDefineViewActivity"
            android:exported="false" />

        <service
            android:name=".scene.BookManagerService"
            android:enabled="true"
            android:exported="true"
            android:process=".booService" />

        <activity
            android:name=".scene.BookManagerActivity"
            android:exported="false" />
        <activity
            android:name=".scene.ReflectActivity"
            android:exported="false" />
        <activity
            android:name=".scene.RetrofitActivity"
            android:exported="false" />
        <activity
            android:name=".scene.EventBusActivity"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="android.app.NativeActivity"
            android:configChanges="orientation|keyboardHidden"
            android:exported="true">
            <meta-data
                android:name="android.app.lib_name"
                android:value="native-activity" />
        </activity>

        <provider
            android:name=".scene.provider.CliffContentProvider"
            android:authorities="com.cliff.conch.provider"
            android:enabled="true"
            android:exported="true"
            android:permission="com.cliff.conch" /> <!-- 移除默认初始化器 -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            tools:node="remove" /> <!-- 添加自定义初始化器 -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="com.cliff.conch.start.CliffWorkManagerInitializer"
                android:value="androidx.startup" />
        </provider> <!-- 使用ContentProvider在进程之间传递Binder -->
        <provider
            android:name=".scene.bp.BinderProvider"
            android:authorities="com.cliff.binder.provider.auth"
            android:enabled="true"
            android:exported="false"
            android:process=":bindProvider" />
        <provider
            android:name=".scene.bp.BinderProvider2"
            android:authorities="com.cliff.binder.provider.auth2"
            android:enabled="true"
            android:exported="false"
            android:process=":bindProvider2" /> <!-- 运行在Server进程，模拟SystemServer进程 -->
        <provider
            android:name=".box.service.ProxyServiceProvider"
            android:authorities="com.cliff.conch.box.system_server_proxy"
            android:enabled="true"
            android:exported="false"
            android:process=":box.server_proxy" />

        <service
            android:name=".box.service.ProxyService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:process=":box.server_proxy" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.cliff.conch.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_path" />
        </provider>

<!--        <receiver-->
<!--            android:name=".scene.ApkInstallReceiver"-->
<!--            android:enabled="true"-->
<!--            android:exported="true">-->
