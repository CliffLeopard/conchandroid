<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".ConchApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Conchandroid"
        tools:targetApi="31">
        <activity
            android:name=".scene.CoroutineActivity"
            android:exported="false" />
        <activity
            android:name=".scene.RxJavaActivity"
            android:exported="false" />
        <activity
            android:name=".scene.provider.ProviderActivity"
            android:exported="false" />

        <provider
            android:name=".scene.provider.CliffContentProvider"
            android:authorities="com.cliff.conch.provider"
            android:enabled="true"
            android:exported="true"
            android:permission="com.cliff.conch" /> <!-- 移除默认初始化器 -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            tools:node="remove" /> <!-- 添加自定义初始化器 -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="com.cliff.conch.start.CliffWorkManagerInitializer"
                android:value="androidx.startup" />
        </provider>

        <activity
            android:name=".scene.ANRActivity"
            android:exported="false" />
        <activity
            android:name=".scene.NativeMessageActivity"
            android:exported="false" />
        <activity
            android:name=".scene.PineActivity"
            android:exported="false" />
        <activity
            android:name=".scene.SelfDefineViewActivity"
            android:exported="false" />

        <service
            android:name=".scene.BookManagerService"
            android:enabled="true"
            android:exported="true"
            android:process=".booService" />

        <activity
            android:name=".scene.BookManagerActivity"
            android:exported="false" />
        <activity
            android:name=".scene.ReflectActivity"
            android:exported="false" />
        <activity
            android:name=".scene.RetrofitActivity"
            android:exported="false" />
        <activity
            android:name=".scene.EventBusActivity"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="android.app.NativeActivity"
            android:configChanges="orientation|keyboardHidden"
            android:exported="true">
            <meta-data
                android:name="android.app.lib_name"
                android:value="native-activity" />
        </activity>
    </application>

</manifest>